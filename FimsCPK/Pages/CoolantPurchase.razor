@page "/coolantpurchase"

@using FimsCPK.Data
@using FimsCPK.Models;
@using FimsCPK.Services
@using Telerik.DataSource
@using Telerik.DataSource.Extensions
@using Telerik.FontIcons;
@using ClosedXML.Excel;
@using System.Data;
@inject IJSRuntime JsRuntime
@inject CpkService cpkService

<AuthorizeView>
    <Authorized>
        <TelerikCard>
            @************************** PAGE HEADER 구성 *************************************************************
            기간설정 (년/월~년/월),찾기 버튼
            ********************************************************************************************************@
            <CardHeader>
                <div style="display: flex; justify-content: flex-start; align-items: left;">
                    <h7><strong>구매일자:</strong>:</h7>
                    <div style="margin-right:5px"></div>
                    <TelerikDatePicker Min="@gMinYear" Max="@gMaxYear" @bind-Value="@gDatePurchase"
                    BottomView="@CalendarView.Month"
                    Format="yyyy-MM-dd" Width="120px"></TelerikDatePicker>
                    <div style="margin-right:20px"></div>
                    <h7><strong>Coolant이름:</strong></h7>
                    <div style="margin-right:5px"></div>
                    <TelerikTextBox @bind-Value="@gStrCoolantName" Width="150px" />
                    <div style="margin-right:20px"></div>
                    <h7><strong>구매량:</strong></h7>
                    <div style="margin-right:5px"></div>
                    <TelerikTextBox @bind-Value="@gStrAmount" Width="150px" />
                    <div style="margin-right:20px"></div>
                    <TelerikButton ThemeColor="success" OnClick="@SearchCoolantPurchase" Icon="FontIcon.Search">구매 입력하기</TelerikButton>
                    <div style="margin-right:20px"></div>
                </div>
            </CardHeader>
            <CardHeader>
                <div style="display: flex; justify-content: flex-start; align-items: left;">
                    @*
                    <TelerikDatePicker Min="@gMinYear" Max="@gMaxYear" @bind-Value="@gStartYear"
                    BottomView="@CalendarView.Year"
                    Format="yyyy-MM" Width="120px"></TelerikDatePicker>
                    ~
                    <TelerikDatePicker @bind-Value="@gEndYear"
                    BottomView="@CalendarView.Year"
                    Format="yyyy-MM" Width="120px"></TelerikDatePicker>
                    <div style="margin-right:20px"></div>
                    *@
                    <TelerikButton ThemeColor="success" OnClick="@SearchCoolantPurchase" Icon="FontIcon.Search">Coolant구매 조회</TelerikButton>
                </div>
            </CardHeader>
            <CardBody>
                <TelerikGrid Class="cpk-grid"
                @ref="@GridRefPurchase"
                Data="@gCoolantPurchaseInfo"
                Pageable="false"
                Groupable="false"
                Sortable="false"
                Resizable="false"
                PageSize=100
                Navigable="true"
                Height="30%">
                    <GridColumns>
                        <GridColumn Field=@nameof(CoolantPurchaseInfo.CoolantName) Width="60px" Title="Coolant" Sortable=true />
                        <GridColumn Field=@nameof(CoolantPurchaseInfo.dtPurchased) Width="60px" Title="구입일자" Sortable=true />
                        <GridColumn Field=@nameof(CoolantPurchaseInfo.amount_purchase) Width="60px" Title="구입량" Sortable=true />
                    </GridColumns>
                </TelerikGrid>
            </CardBody>
        </TelerikCard>
    </Authorized>
</AuthorizeView>

@code {
    /*
         *  1) Coolant 구매 관련 화면
         *  2) 입력하기 : Coolant 종류, 수량, 날짜
         *  3) 구성 : 기간설정 시작월~끝월
         *  4) List : 구매 이력 (SearchBox에서 Coolant이름으로 Filtering 가능)
         *            삭제/수정하기 기능 (Admin의 경우에만)
         * 
        */

    //--- 구매량 입력하기
    private string gStrAmount { get; set; }
    private string gStrCoolantName { get; set; }
    
    //--- 검색날짜
    //--- 검색 기간 : 2023~2030 사이
    private DateTime gMinYear = new DateTime(2025, 1, 1, 0, 0, 0);
    private DateTime gMaxYear = new DateTime(2040, 1, 1, 0, 0, 0);
    private DateTime gStartYear = DateTime.Now;
    private DateTime gEndYear = DateTime.Now;
    private DateTime gDatePurchase = DateTime.Now;

    //--- Grid
    private List<CoolantPurchaseInfo> gCoolantPurchaseInfo = new List<CoolantPurchaseInfo>();
    private int gNumDevices = 0;
    private TelerikGrid<CoolantPurchaseInfo> GridRefPurchase { get; set; }

    private void SearchCoolantPurchase()
    {
        
    }

}

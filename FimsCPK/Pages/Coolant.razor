@page "/coolant"
@using FimsCPK.Data
@using FimsCPK.Services
@using Telerik.FontIcons
@inject CpkService cpkService

@************************** PAGE TITLE *****************************************************************@
<PageTitle>Fims Dashboard</PageTitle>
<div class="card-header text-lg-center pt-2 pb-2 fw-bold px-9"> Coolant사용양 </div>

<AuthorizeView>
    <Authorized>
        <TelerikCard>
            @************************** PAGE HEADER 구성 *************************************************************
            기간설정 (년/월~년/월), 모델 선택, 테스트항목 선택,   (채널선택==> 모든 채널 표시), CPK_CHECK 버튼
            ********************************************************************************************************@
            <CardHeader>
                <div style="display: flex; justify-content: flex-start; align-items: left;">
                    <TelerikDatePicker Min="@gMinYear" Max="@gMaxYear" @bind-Value="@gStartYear"
                    BottomView="@CalendarView.Year"
                    Format="yyyy-MM" Width="120px"></TelerikDatePicker>
                    ~
                    <TelerikDatePicker @bind-Value="@gEndYear"
                    BottomView="@CalendarView.Year"
                    Format="yyyy-MM" Width="120px"></TelerikDatePicker>

                    <div style="margin-right:20px"></div>
                    <h7><strong>투입양 있는 장비만:</strong></h7>
                    <div style="margin-right:5px"></div>
                    <TelerikCheckBox Id="myIncludeDate" @bind-Value="@gOnlyDataExist" />&nbsp;&nbsp

                    <div style="margin-right:20px"></div>
                    <TelerikButton ThemeColor="success" OnClick="@SearchDevices" Icon="FontIcon.Search">검색하기</TelerikButton>
                    <div style="margin-right:20px"></div>
                    <h4><strong>장비수=@gNumDevices</strong></h4>
                    <div style="margin-right:100px"></div>
                    <TelerikButton ThemeColor="primary" OnClick="@ShowPurchaseCoolant" Icon="FontIcon.Search">Coolant구매조회/입력</TelerikButton>
                </div>
            </CardHeader>
            <CardBody>
                <div style="display: flex; justify-content: flex-start; align-items: left;">
                    <h5>Coolant 통계</h5>
                </div>
                <TelerikGrid Class="cpk-grid"
                @ref="@GridRefStat"
                Data="@gCoolantStats"
                Pageable="false"
                Groupable="false"
                Sortable="false"
                Resizable="false"
                PageSize=100
                Navigable="true"
                Height="30%">
                    <GridColumns>
                        <GridColumn Field=@nameof(CoolantAmount.coolantname) Width="60px" Title="Coolant" Sortable=true />
                        <GridColumn Field=@nameof(CoolantAmount.amount_purchase) Width="60px" Title="총구매양" Sortable=true />
                        <GridColumn Field=@nameof(CoolantAmount.amount_usage) DisplayFormat="{0:N2}" Width="60px" Title="투입양(사용양)" Sortable=true />
                        <GridColumn Field=@nameof(CoolantAmount.amount_drain) DisplayFormat="{0:N2}" Width="60px" Title="회수양" Sortable=true />
                        <GridColumn Field=@nameof(CoolantAmount.amount_notdrain) DisplayFormat="{0:N2}" Width="30px" Title="미회수양(사용양)" Sortable=true />
                        <GridColumn Field=@nameof(CoolantAmount.amount_remain) DisplayFormat="{0:N2}" Width="60px" Title="재고양(총구매양-미회수양)" Sortable=true />
                    </GridColumns>
                </TelerikGrid>
            </CardBody>

            <CardBody>
                <h5>검사장비 List</h5>
                <TelerikGrid Class="cpk-grid"
                @ref="@GridRefCoolant"
                Data="@gCoolantInfo"
                Pageable="false"
                Groupable="false"
                Sortable="false"
                Resizable="false"
                PageSize=100
                Navigable="true"
                Height="100%">
                    <GridToolBarTemplate>
                        <GridSearchBox Placeholder="@Placeholder" Width="300px" DebounceDelay="@DebounceDelay" />
                        <span>Write in the textbox on the left-hand side to filter all string columns.</span>
                    </GridToolBarTemplate>
                    <GridColumns>
                        <GridColumn Field=@nameof(CoolantInfo.serial) Width="60px" Title="SN" Sortable=true />
                        <GridColumn Field=@nameof(CoolantInfo.model) Width="60px" Title="Model값" Sortable=true />
                        <GridColumn Field=@nameof(CoolantInfo.dateEnded) Width="60px" Title="검사완료" Sortable=true />
                        <GridColumn Field=@nameof(CoolantInfo.NumCh) Width="30px" Title="# Ch" Sortable=true />
                        <GridColumn Width="30px" Title="Ch1 Coolant" Sortable=true>
                            <Columns>
                                <GridColumn Field=@nameof(CoolantInfo.coolantname1) Width="30px" Title="종류" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantcharge1) Width="30px" Title="투입양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain11) Width="30px" Title="1차회수양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain12) Width="30px" Title="2차회수양" Sortable=true />
                            </Columns>
                        </GridColumn>
                        <GridColumn Width="30px" Title="Ch2 Coolant" Sortable=true>
                            <Columns>
                                <GridColumn Field=@nameof(CoolantInfo.coolantname2) Width="30px" Title="종류" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantcharge2) Width="30px" Title="투입양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain21) Width="30px" Title="1차회수양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain22) Width="30px" Title="2차회수양" Sortable=true />
                            </Columns>
                        </GridColumn>
                        <GridColumn Width="30px" Title="Ch3 Coolant" Sortable=true>
                            <Columns>
                                <GridColumn Field=@nameof(CoolantInfo.coolantname3) Width="30px" Title="종류" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantcharge3) Width="30px" Title="투입양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain31) Width="30px" Title="1차회수양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain32) Width="30px" Title="2차회수양" Sortable=true />
                            </Columns>
                        </GridColumn>
                        <GridColumn Width="30px" Title="Ch4 Coolant" Sortable=true>
                            <Columns>
                                <GridColumn Field=@nameof(CoolantInfo.coolantname4) Width="30px" Title="종류" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantcharge4) Width="30px" Title="투입양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain41) Width="30px" Title="1차회수양" Sortable=true />
                                <GridColumn Field=@nameof(CoolantInfo.coolantdrain42) Width="30px" Title="2차회수양" Sortable=true />
                            </Columns>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            </CardBody>
        </TelerikCard>
        <TelerikWindow Visible="@CoolanPurchaseWindowVisible"
        VisibleChanged="@CoolantPurchaseVisibleChangedHandler"
        Modal="true"
        Draggable="true"
        Resizable="true"
        MinHeight="200px"
        Height="80%"
        MaxHeight="100%"
        MinWidth="400px"
        Width="80%"
        MaxWidth="100%">
            <WindowTitle>
                <h4 style="color:blue"><strong>Coolant 구매이력</strong></h4>
            </WindowTitle>
            <WindowActions>
                <WindowAction Name="Close" />
            </WindowActions>
            <WindowContent>
                <CoolantPopup> </CoolantPopup>
            </WindowContent>
        </TelerikWindow>
    </Authorized>
</AuthorizeView>


@code {

    //--- 장비 List : 장비, 쿨런트 사용양/회수양
    private List<CoolantInfo> gCoolantInfo = new List<CoolantInfo>();
    private int gNumDevices = 0;
    private TelerikGrid<CoolantInfo> GridRefCoolant{ get; set; }

    //--- 쿨런트 통계
    private List<CoolantAmount> gCoolantStats = new List<CoolantAmount>();
    private int gNumCoolant = 0;
    private TelerikGrid<CoolantAmount> GridRefStat { get; set; }

    //--- 검색날짜
    //--- 검색 기간 : 2023~2030 사이
    private DateTime gMinYear = new DateTime(2023, 1, 1, 0, 0, 0);
    private DateTime gMaxYear = new DateTime(2030, 1, 1, 0, 0, 0);
    private DateTime gStartYear = DateTime.Now;
    private DateTime gEndYear = DateTime.Now;
    private bool gOnlyDataExist = true;

    //--- Search Box
    private string Placeholder { get; set; } = "Search...";
    private int DebounceDelay { get; set; } = 200;

    //--- Coolant 구입
    //--- Model Add Window
    private bool CoolanPurchaseWindowVisible = false;


    protected override async Task OnInitializedAsync()
    {
        SearchDevices();
    }

    private void SearchDevices()
    {
        DateTime dateStart = new DateTime(gStartYear.Year, gStartYear.Month, 1, 0, 0, 0);
        DateTime dateEnd = new DateTime(gEndYear.Year, gEndYear.Month, 1, 0,0,0);
        dateEnd = dateEnd.AddMonths(1);

        gCoolantInfo = GetCoolantInfo(dateStart, dateEnd);

        //--- Remove DI-Water
        gCoolantInfo = gCoolantInfo.Where(x => x.coolantname1 != null && x.coolantname1.Contains("WATER") == false).ToList();
        if (gOnlyDataExist == true)
            gCoolantInfo = gCoolantInfo.Where(x => x.coolantcharge1 > 0).ToList();

        gNumDevices = gCoolantInfo.Count;
        GridRefCoolant?.Rebind();

        //--- Get Coolant List
        gCoolantStats = GetUsedCoolantList();

        StateHasChanged();
    }

    private List<CoolantInfo> GetCoolantInfo(DateTime start, DateTime end)
    {
        List<CoolantInfo> lstInfo = new List<CoolantInfo>();

        lstInfo = cpkService.GetCoolantInfoFromFIMS(start, end);
        return lstInfo;
    }

    //--- Coolant 종류를 구한다.
    private List<CoolantAmount> GetUsedCoolantList()
    {
        List<CoolantAmount> lstCoolantUsage = new List<CoolantAmount>();
        List<string> cool1 = gCoolantInfo.Where(x => x.coolantname1 != null).Select(t => t.coolantname1).Distinct().ToList();
        List<string> cool2 = gCoolantInfo.Where(x => x.coolantname2 != null).Select(t => t.coolantname2).Distinct().ToList();
        List<string> cool3 = gCoolantInfo.Where(x => x.coolantname3 != null).Select(t => t.coolantname3).Distinct().ToList();
        List<string> cool4 = gCoolantInfo.Where(x => x.coolantname4 != null).Select(t => t.coolantname4).Distinct().ToList();

        cool1 = cool1.Union(cool2).Union(cool3).Union(cool4).OrderBy(x => x).ToList();
        foreach(var cl in cool1)
        {
            CoolantAmount ca = new CoolantAmount();

            ca.coolantname = cl;
            ca.amount_usage = gCoolantInfo.Where(x => x.coolantname1 == cl).Sum(x => x.coolantcharge1)
                            + gCoolantInfo.Where(x => x.coolantname2 == cl).Sum(x => x.coolantcharge2)
                            + gCoolantInfo.Where(x => x.coolantname3 == cl).Sum(x => x.coolantcharge3)
                            + gCoolantInfo.Where(x => x.coolantname4 == cl).Sum(x => x.coolantcharge4);   // 투입양 합
            ca.amount_drain = gCoolantInfo.Where(x => x.coolantname1 == cl).Sum(x => x.coolantdrain11)
                            + gCoolantInfo.Where(x => x.coolantname1 == cl).Sum(x => x.coolantdrain12)
                            + gCoolantInfo.Where(x => x.coolantname2 == cl).Sum(x => x.coolantdrain21)
                            + gCoolantInfo.Where(x => x.coolantname2 == cl).Sum(x => x.coolantdrain22)
                            + gCoolantInfo.Where(x => x.coolantname3 == cl).Sum(x => x.coolantdrain31)
                            + gCoolantInfo.Where(x => x.coolantname3 == cl).Sum(x => x.coolantdrain32)
                            + gCoolantInfo.Where(x => x.coolantname4 == cl).Sum(x => x.coolantdrain41)
                            + gCoolantInfo.Where(x => x.coolantname4 == cl).Sum(x => x.coolantdrain42);   // 회수양 합
            ca.amount_notdrain = ca.amount_usage - ca.amount_drain;
            ca.amount_purchase = cpkService.GetCoolantPurchase(cl);
            ca.amount_remain = ca.amount_purchase - ca.amount_notdrain;
            lstCoolantUsage.Add(ca);
        }

        return lstCoolantUsage;
    }

    //==========================================================================
    //--- 구매양 검색/입력 화면 Popup
    private void ShowPurchaseCoolant()
    {
        CoolanPurchaseWindowVisible = true; 
    }
    //
    void CoolantPurchaseVisibleChangedHandler(bool currVisible)
    {
        CoolanPurchaseWindowVisible = currVisible;
    }

}
